{
  "version": 5,
  "master_seed": 424242,

  "audio": {
    "sample_rate": 22050,
    "duration_s": 4.0
  },

  "output": {
    "clean_before_build": true,
    "total_samples": 20,
    "split_ratio": [0.7, 0.15, 0.15]
  },

  "sources": {
    "dads_root": "dataset_DADS_offline",
    "labels": {
      "ambient": "0",
      "drone": "1"
    },
    "split_policy": {
      "ratios": { "train": 0.85, "val": 0.10, "test": 0.05 }
    }
  },

  "scenarios": [
    {
      "name": "ambient_only",
      "weight": 1.0,
      "label": 0,
      "components": [
        { "role": "ambient", "count": 1, "chain_template": [ { "op": "gain_db", "params": { "db": { "dist": "uniform", "min": -6, "max": 0 } } } ] }
      ],
      "global_chain_template": [ { "op": "normalize_peak", "params": { "target_dbfs": -1.0 } }, { "op": "stats", "params": { "sr": 22050 } } ]
    },
    {
      "name": "drone_plus_ambient",
      "weight": 1.0,
      "label": 1,
      "components": [
        { "role": "drone", "count": 1, "chain_template": [ { "op": "distance_atten", "params": { "distance_m": { "dist": "uniform", "min": 50, "max": 250 } } } ] },
        { "role": "ambient", "count": 1, "chain_template": [ { "op": "gain_db", "params": { "db": { "dist": "uniform", "min": -6, "max": 0 } } } ] }
      ],
      "global_chain_template": [ { "op": "normalize_peak", "params": { "target_dbfs": -1.0 } }, { "op": "stats", "params": { "sr": 22050 } } ]
    }
  ],

  "mix": {
    "mode": "sum",
    "normalize_peak_dbfs": -1.0
  }
}
