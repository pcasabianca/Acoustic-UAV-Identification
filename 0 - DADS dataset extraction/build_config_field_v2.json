{
  "version": 5,
  "master_seed": 424242,

  "audio": { "sample_rate": 22050, "duration_s": 4.0 },

  "output": { "clean_before_build": true, "total_samples": 200, "split_ratio": [0.7, 0.15, 0.15] },

  "targets": {
    "label0_ratio": 0.30,
    "distance_bins_m": [0, 60, 150, 300],
    "distance_bin_weights_label1": [0.25, 0.35, 0.40],
    "moving_ratio_label1": 0.70,
    "doppler_ratio_label1": 0.70,
    "strong_noise_ratio": 0.25,
    "strong_noise_dbfs": -55.0,
    "snr_bins_db": [-100, -30, -20, -10, 0, 20],
    "snr_bin_weights_label1": [0.10, 0.25, 0.30, 0.20, 0.10],
    "strict": false
  },

  "sources": { "dads_root": "dataset_DADS_offline", "labels": { "ambient": "0", "drone": "1" }, "split_policy": { "ratios": { "train": 0.85, "val": 0.10, "test": 0.05 } } },

  "scenarios": [
    { "name": "noise_only_1amb", "weight": 0.12, "label": 0, "components": [ { "role": "ambient", "count": 1, "chain_template": [ { "op": "gain_db", "params": { "db": { "dist": "uniform", "min": -8, "max": 0 } } }, { "op": "ambient_orch", "params": { "sr": 22050, "dropout": { "enabled": true, "prob": 0.05 } } } ] } ], "global_chain_template": [ { "op": "hardware_orch", "params": { "noise_rms_dbfs": -60, "adc_bits": 12, "hp_hz": 100, "sr": 22050 } }, { "op": "normalize_peak", "params": { "target_dbfs": -1.0 } }, { "op": "stats", "params": { "sr": 22050 } } ] },

    { "name": "noise_only_complex", "weight": 0.08, "label": 0, "components": [ { "role": "ambient", "count": 1, "chain_template": [ { "op": "ambient_orch", "params": { "sr": 22050, "dropout": { "enabled": true, "prob": 0.1 }, "softclip": { "enabled": true, "drive_db": 6 } } } ] } ], "global_chain_template": [ { "op": "hardware_orch", "params": { "noise_rms_dbfs": -50, "adc_bits": 8, "hp_hz": 200, "sr": 22050 } }, { "op": "normalize_peak", "params": { "target_dbfs": -1.0 } }, { "op": "stats", "params": { "sr": 22050 } } ] },

    { "name": "drone_near_static", "weight": 0.10, "label": 1, "components": [ { "role": "drone", "count": 1, "chain_template": [ { "op": "env_orch", "params": { "distance_mode": "static", "distance_m": { "dist": "uniform", "min": 5, "max": 60 }, "ref_m": 1.0, "sr": 22050, "doppler": { "enabled": false } } }, { "op": "drone_orch", "params": { "flutter_db": 1.0, "flutter_hz": 0.6, "sr": 22050 } } ] }, { "role": "ambient", "count": 1, "chain_template": [ { "op": "ambient_orch", "params": { "sr": 22050, "dropout": { "enabled": true, "prob": 0.03 } } } ] } ], "global_chain_template": [ { "op": "hardware_orch", "params": { "noise_rms_dbfs": -60, "adc_bits": 12, "hp_hz": 100, "sr": 22050 } }, { "op": "normalize_peak", "params": { "target_dbfs": -1.0 } }, { "op": "stats", "params": { "sr": 22050 } } ] },

    { "name": "drone_far_moving", "weight": 0.12, "label": 1, "components": [ { "role": "drone", "count": 1, "chain_template": [ { "op": "env_orch", "params": { "distance_mode": "trajectory", "distance_start_m": { "dist": "uniform", "min": 150, "max": 300 }, "distance_end_m": { "dist": "uniform", "min": 40, "max": 80 }, "ref_m": 1.0, "sr": 22050, "doppler": { "enabled": true, "v_mps": { "dist": "uniform", "min": 8, "max": 18 }, "direction": 1, "segments": 28, "max_ratio": 1.06 } } }, { "op": "drone_orch", "params": { "flutter_db": 1.6, "flutter_hz": 0.9, "sr": 22050 } } ] }, { "role": "ambient", "count": 1, "chain_template": [ { "op": "ambient_orch", "params": { "sr": 22050, "softclip": { "enabled": true, "drive_db": 3 } } } ] } ], "global_chain_template": [ { "op": "hardware_orch", "params": { "noise_rms_dbfs": -55, "adc_bits": 8, "hp_hz": 100, "sr": 22050 } }, { "op": "normalize_peak", "params": { "target_dbfs": -1.0 } }, { "op": "stats", "params": { "sr": 22050 } } ] },

    { "name": "multi_drone", "weight": 0.10, "label": 1, "components": [ { "role": "drone", "count": 2, "chain_template": [ { "op": "env_orch", "params": { "distance_mode": "static", "distance_m": { "dist": "uniform", "min": 60, "max": 200 }, "ref_m": 1.0, "sr": 22050, "doppler": { "enabled": true, "v_mps": { "dist": "uniform", "min": 4, "max": 12 }, "direction": 1, "segments": 16, "max_ratio": 1.04 } } }, { "op": "drone_orch", "params": { "flutter_db": 1.2, "flutter_hz": 0.8, "sr": 22050 } } ] }, { "role": "ambient", "count": 1, "chain_template": [ { "op": "ambient_orch", "params": { "sr": 22050 } } ] } ], "global_chain_template": [ { "op": "hardware_orch", "params": { "noise_rms_dbfs": -60, "adc_bits": 12, "hp_hz": 100, "sr": 22050 } }, { "op": "normalize_peak", "params": { "target_dbfs": -1.0 } }, { "op": "stats", "params": { "sr": 22050 } } ] }

  ],

  "mix": { "mode": "sum", "normalize_peak_dbfs": -1.0 }
}
