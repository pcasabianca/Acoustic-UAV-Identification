{
  "version": "1.0",
  "description": "Raspberry Pi Real-Time Drone Detection Configuration",
  
  "audio": {
    "sample_rate": 22050,
    "duration_seconds": 4,
    "channels": 1,
    "normalize_peak": 0.95,
    "input_directory": "./audio_input",
    "file_pattern": "*.wav",
    "delete_after_processing": true
  },
  
  "detection": {
    "scan_interval_seconds": 4,
    "confidence_threshold_default": 0.5,
    "thresholds_file": "./thresholds.json",
    "enabled_models": ["CNN", "RNN", "CRNN", "Attention-CRNN", "tcn", "efficientnet", "mobilenet"],
    "voting_strategy": "majority",
    "min_consecutive_detections": 2,
    "reload_thresholds_every_prediction": true,
    "description": "All 8 models loaded. Thresholds from thresholds.json (modify on-the-fly)."
  },
  
  "models": {
    "directory": "./models",
    "available_models": {
      "CNN": {
        "filename": "cnn_model.keras",
        "architecture": "CNN",
        "description": "CNN model",
        "calibrated_key": "cnn_model"
      },
      "RNN": {
        "filename": "rnn_model.keras",
        "architecture": "RNN",
        "description": "RNN model",
        "calibrated_key": "rnn_model"
      },
      "CRNN": {
        "filename": "crnn_model.keras",
        "architecture": "CRNN",
        "description": "CRNN model",
        "calibrated_key": "crnn_model"
      },
      "Attention-CRNN": {
        "filename": "attention_crnn_model.keras",
        "architecture": "Attention-CRNN",
        "description": "Attention-CRNN model",
        "calibrated_key": "attention_crnn_model"
      },
      "conformer": {
        "filename": "conformer_model.keras",
        "architecture": "Conformer",
        "description": "Conformer model with Lambda layers",
        "calibrated_key": "conformer_model",
        "safe_mode": false
      },
      "tcn": {
        "filename": "tcn_model.keras",
        "architecture": "TCN",
        "description": "Temporal Convolutional Network",
        "calibrated_key": "tcn_model"
      },
      "efficientnet": {
        "filename": "efficientnet_model.keras",
        "architecture": "EfficientNet",
        "description": "EfficientNet model",
        "calibrated_key": "efficientnet_model"
      },
      "mobilenet": {
        "filename": "mobilenet_model.keras",
        "architecture": "MobileNet",
        "description": "MobileNet model",
        "calibrated_key": "mobilenet_model"
      }
    }
  },
  
  "feature_extraction": {
    "mel_spectrogram": {
      "n_mels": 44,
      "n_fft": 2048,
      "hop_length": 512,
      "fmin": 20,
      "fmax": 11025
    },
    "normalization": false,
    "preprocessing": "none",
    "description": "MEL extraction with ref=1.0, NO normalization to preserve SNR differences"
  },
  
  "output": {
    "log_directory": "./logs",
    "log_level": "INFO",
    "save_predictions": true,
    "predictions_file": "./logs/predictions.json",
    "alert_sound": false,
    "console_output": true,
    "timestamp_format": "%Y-%m-%d %H:%M:%S",
    "show_prediction_statistics": true
  },
  
  "alerts": {
    "enabled": true,
    "methods": ["console", "log"],
    "drone_detected_message": "🚨 DRONE DETECTED",
    "no_drone_message": "✓ No drone detected",
    "include_confidence": true,
    "include_model_breakdown": true
  },
  
  "performance": {
    "use_gpu": false,
    "batch_size": 1,
    "num_threads": 2,
    "memory_limit_mb": 512,
    "optimize_for_raspberry_pi": true
  },
  
  "recording": {
    "enabled": false,
    "device_index": 0,
    "auto_record": false,
    "save_recordings": false,
    "recordings_directory": "./recordings",
    "description": "Set enabled=true to record from microphone instead of file monitoring"
  }
}
